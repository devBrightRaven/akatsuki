<!DOCTYPE html>
<html lang="{{ lang or 'en' }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} | {% endif %}{{ site.i18n[lang].siteTitle }}</title>
{% if description %}<meta name="description" content="{{ description }}">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" hreflang="en" href="{{ site.url }}{{ page.url | translation('en') }}">
<link rel="alternate" hreflang="zh-TW" href="{{ site.url }}{{ page.url | translation('zh') }}">
<link rel="alternate" type="application/rss+xml" href="{{ site.feedUrl[lang] }}" title="{{ site.i18n[lang].siteTitle }}">
<link rel="stylesheet" href="/assets/style.css">
<meta property="og:type" content="article">
<meta property="og:title" content="{{ title or site.i18n[lang].siteTitle }}">
{% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
</head>
<body>
<a class="skip-link" href="#main">{{ site.i18n[lang].skipToContent }}</a>

<header class="site-header" role="banner">
  <a class="site-title" href="{% if lang == 'zh-TW' %}/zh/{% else %}/{% endif %}">{{ site.i18n[lang].siteTitle }}</a>
  <nav aria-label="{{ site.i18n[lang].switchLang }}">
    <a href="{{ page.url | translation(site.i18n[lang].switchLangCode) }}" lang="{{ site.i18n[lang].switchLangCode }}" hreflang="{{ site.i18n[lang].switchLangCode }}">{{ site.i18n[lang].switchLang }}</a>
  </nav>
</header>

<main id="main" tabindex="-1">
{{ content | safe }}
</main>

<footer class="site-footer" role="contentinfo">
  <p>{{ site.i18n[lang].productCTA }} <a href="{{ site.product.url }}">{{ site.product.name }} →</a></p>
  <p class="meta">
    <a href="{{ site.feedUrl[lang] }}">RSS</a>
    · <a href="{{ site.social.github }}">GitHub</a>
  </p>
  <p class="quiet">{{ site.i18n[lang].noNewsletter }}</p>
</footer>
</body>
</html>
