<!DOCTYPE html>
<html lang="{{ lang or 'en' }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" href="data:,">
<title>{% if title %}{{ title }} | {% elif pagination and pagination.pageNumber > 0 %}{{ site.i18n[lang].page }} {{ pagination.pageNumber + 1 }}{{ site.i18n[lang].pageSuffix }} | {% endif %}{{ site.i18n[lang].siteTitle }}</title>
{% set metaDescription = description or site.i18n[lang].tagline %}
<meta name="description" content="{{ metaDescription }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{% set alternateEn = page.url | translation('en', collections.allPostsEn, collections.allPostsJa, collections.allPostsZh, false) %}
{% set alternateJa = page.url | translation('ja', collections.allPostsEn, collections.allPostsJa, collections.allPostsZh, false) %}
{% set alternateZh = page.url | translation('zh-TW', collections.allPostsEn, collections.allPostsJa, collections.allPostsZh, false) %}
{% if alternateEn %}<link rel="alternate" hreflang="en" href="{{ site.url }}{{ alternateEn }}">{% endif %}
{% if alternateJa %}<link rel="alternate" hreflang="ja" href="{{ site.url }}{{ alternateJa }}">{% endif %}
{% if alternateZh %}<link rel="alternate" hreflang="zh-TW" href="{{ site.url }}{{ alternateZh }}">{% endif %}
{% if section and alternateEn %}<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ alternateEn }}">{% endif %}
<link rel="alternate" type="application/rss+xml" href="{{ site.feedUrl[lang] }}" title="{{ site.i18n[lang].siteTitle }}">
<script>
(() => {
  let saved = "auto";
  try { saved = localStorage.getItem("akatsuki-theme") || "auto"; } catch {}
  if (!["auto", "light", "dark"].includes(saved)) saved = "auto";
  const dark = saved === "dark" || (saved === "auto" && matchMedia("(prefers-color-scheme: dark)").matches);
  document.documentElement.dataset.theme = dark ? "dark" : "light";
  document.documentElement.style.colorScheme = dark ? "dark" : "light";
})();
</script>
<link rel="stylesheet" href="/assets/style.css?v=20260809-1">
<meta property="og:type" content="{% if bodyClass == 'home-page' %}website{% else %}article{% endif %}">
<meta property="og:title" content="{% if title %}{{ title }}{% elif pagination and pagination.pageNumber > 0 %}{{ site.i18n[lang].page }} {{ pagination.pageNumber + 1 }}{{ site.i18n[lang].pageSuffix }} | {{ site.i18n[lang].siteTitle }}{% else %}{{ site.i18n[lang].siteTitle }}{% endif %}">
<meta property="og:description" content="{{ metaDescription }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<script src="/assets/theme.js" defer></script>
<script src="/assets/privacy-consent.js" defer></script>
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
<a class="skip-link" href="#main">{{ site.i18n[lang].skipToContent }}</a>

<header id="top" class="site-header" role="banner" tabindex="-1">
  <div class="site-brand">
    <a class="site-title" href="{% if lang == 'zh-TW' %}/zh/{% elif lang == 'ja' %}/ja/{% else %}/{% endif %}"><span lang="ja">曉</span> Akatsuki</a>
    <span class="site-parent">by Bright Raven</span>
  </div>
  <div class="site-controls">
    <nav class="content-navigation" aria-label="{{ site.i18n[lang].contentNavigation }}">
      <a href="{{ site.routes[lang].latest }}"{% if section == 'latest' %} aria-current="page"{% endif %}>{{ site.i18n[lang].latest }}</a>
      <a href="{{ site.routes[lang].series }}"{% if section == 'series' %} aria-current="page"{% endif %}>{{ site.i18n[lang].series }}</a>
      <a href="{{ site.routes[lang].topics }}"{% if section == 'topics' %} aria-current="page"{% endif %}>{{ site.i18n[lang].topicMap }}</a>
    </nav>
    <div class="site-utilities">
      <nav class="language-navigation" aria-label="{{ site.i18n[lang].languageNavigation }}">
        {% if alternateEn %}<a href="{{ alternateEn }}" lang="en" hreflang="en"{% if lang == 'en' %} aria-current="page"{% endif %}>EN</a>{% endif %}
        {% if alternateJa %}<a href="{{ alternateJa }}" lang="ja" hreflang="ja"{% if lang == 'ja' %} aria-current="page"{% endif %}>JA</a>{% endif %}
        {% if alternateZh %}<a href="{{ alternateZh }}" lang="zh-TW" hreflang="zh-TW"{% if lang == 'zh-TW' %} aria-current="page"{% endif %}>繁</a>{% endif %}
      </nav>
      <div class="theme-control" role="group" aria-label="{{ site.i18n[lang].theme }}" data-theme-control>
        <button class="theme-trigger" type="button" aria-expanded="false" aria-controls="theme-menu" data-theme-trigger>
          <span class="theme-trigger-icon" data-theme-icon aria-hidden="true">◐</span>
          <span class="theme-trigger-label">{{ site.i18n[lang].theme }}:</span> <span data-theme-current>{{ site.i18n[lang].themeAuto }}</span>
        </button>
        <div class="theme-menu" id="theme-menu" data-theme-menu hidden>
          <fieldset class="theme-options">
            <legend class="visually-hidden">{{ site.i18n[lang].theme }}</legend>
            <label><input type="radio" name="akatsuki-theme" value="auto" checked> {{ site.i18n[lang].themeAuto }}</label>
            <label><input type="radio" name="akatsuki-theme" value="light"> {{ site.i18n[lang].themeLight }}</label>
            <label><input type="radio" name="akatsuki-theme" value="dark"> {{ site.i18n[lang].themeDark }}</label>
          </fieldset>
        </div>
      </div>
    </div>
  </div>
</header>

<div id="br-consent-root"></div>

<main id="main" tabindex="-1">
{{ content | safe }}
</main>

<footer class="site-footer" role="contentinfo">
  <p><a href="{{ site.studio.url }}">{{ site.studio.name }}</a> · {{ site.i18n[lang].footerDescription }}</p>
  <p class="meta">
    <a href="{{ site.feedUrl[lang] }}">RSS</a>
    · <a href="{{ site.social.github }}">GitHub</a>
    · <button class="privacy-settings" type="button" data-open-privacy>{{ site.i18n[lang].privacyChoices }}</button>
  </p>
  <p class="quiet">{{ site.i18n[lang].noNewsletter }}</p>
</footer>
<button class="back-to-top" type="button" aria-label="{{ site.i18n[lang].backToTop }}" title="{{ site.i18n[lang].backToTop }}" hidden>
  <svg class="back-to-top-icon" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M8.1 5.7L8.4 10.7L12.2 17.2L4.6 11.3L4.3 12.7L7 17.6L11.7 21.7L4 19.9L6.7 23.4L11.9 26.4L7.3 27.4L16.5 35.6L26.4 41.1L22.7 54L25.3 53.5L25.9 56.1L30.6 58.1L36.9 56.8L38.6 53.4L41.5 53.4L37.6 41.1L47 36L56.7 26.8L52.1 26.4L57.3 23.4L59.9 19.5L52.3 21.9L57.9 16.5L59.7 11.4L51.9 17.3L55.9 10.2L55.9 5.9L37.2 28.6L31.9 15.3L27 28.6Z"/>
  </svg>
</button>
<script type="module" src="/assets/back-to-top.js"></script>
</body>
</html>
