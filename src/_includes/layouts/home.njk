---
layout: layouts/base.njk
bodyClass: home-page
---
{% if lang == 'en' %}
  {% set seriesPosts = collections.postsEn %}
{% elif lang == 'ja' %}
  {% set seriesPosts = collections.postsJa %}
{% else %}
  {% set seriesPosts = collections.postsZh %}
{% endif %}
<section class="latest-shell" aria-labelledby="latest-title">
  <p class="section-kicker">{% if pagination.pageNumber == 0 %}{{ site.i18n[lang].seriesKicker }}{% else %}{{ site.i18n[lang].moreStories }}{% endif %}</p>
  <h1 id="latest-title">{{ site.series.playersNotInfinite.title[lang] }}</h1>
  <p class="latest-intro">{{ site.series.playersNotInfinite.description[lang] }}</p>
  {% if seriesPosts.length %}<a class="primary-action" href="{{ seriesPosts[0].url }}">{{ site.i18n[lang].startSeries }}</a>{% endif %}
  <ol class="latest-list">
    {% for post in pagePosts %}
    <li class="latest-item">
      <a href="{{ post.url }}">
        <span class="latest-item-number">{{ post.data.storyNumber }}</span>
        <span class="latest-item-copy">
          <strong>{{ post.data.displayTitle }}</strong>
          <span>{{ post.data.description }}</span>
          <small><time datetime="{{ post.date | isoDate }}">{{ post.date | localizedDate(lang) }}</time> · {{ post.data.topicLabel }} · {{ post.templateContent | readingTime }} {{ site.i18n[lang].readingTime }}</small>
        </span>
      </a>
    </li>
    {% endfor %}
  </ol>
</section>

{% if pagination.pageNumber > 0 and pagination.pages.length > 1 %}
<nav class="pagination-nav" aria-label="{{ site.i18n[lang].pagination }}">
  <p class="pagination-status" aria-current="page">{{ site.i18n[lang].page }} {{ pagination.pageNumber + 1 }} {{ site.i18n[lang].of }} {{ pagination.pages.length }}{{ site.i18n[lang].pageSuffix }}</p>
  <div class="pagination-actions">
    {% if pagination.href.previous %}
    <a class="pagination-link pagination-previous" href="{{ pagination.href.previous }}" rel="prev">
      <strong>{{ site.i18n[lang].previousPage }}</strong>
    </a>
    {% endif %}
    {% if pagination.href.next %}
    <a class="pagination-link pagination-next" href="{{ pagination.href.next }}" rel="next">
      <strong>{{ site.i18n[lang].nextPage }}</strong>
    </a>
    {% endif %}
  </div>
</nav>
{% endif %}
