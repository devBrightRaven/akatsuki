---
layout: layouts/base.njk
---
{% if lang == 'en' %}
  {% set posts = collections.postsEn %}
{% elif lang == 'ja' %}
  {% set posts = collections.postsJa %}
{% else %}
  {% set posts = collections.postsZh %}
{% endif %}
{% set previousPost = posts | getPreviousCollectionItem %}
{% set nextPost = posts | getNextCollectionItem %}
<article>
  {% if topicLabel %}<p class="post-topic-label">{{ topicLabel }}</p>{% endif %}
  {{ content | safe }}

  {% if seriesId or topicIds %}
  <aside class="article-context" aria-label="{{ site.i18n[lang].storyNavigation }}">
    {% if seriesId %}<p><span>{{ site.i18n[lang].series }}</span> <a href="{{ site.routes[lang].series }}">{{ series }}</a></p>{% endif %}
    {% if topicIds %}
    <p><span>{{ site.i18n[lang].topics }}</span>
      {% for topic in site.topicCatalog %}{% if topic.id in topicIds %}<a href="{{ site.routes[lang].topics }}">{{ topic.labels[lang] }}</a>{% if not loop.last %} {% endif %}{% endif %}{% endfor %}
    </p>
    {% endif %}
  </aside>
  {% endif %}

  <footer class="post-footer">
    <p class="post-meta">
      <span>{{ content | readingTime }} {{ site.i18n[lang].readingTime }}</span>
    </p>
    <nav class="post-navigation" aria-label="{{ site.i18n[lang].storyNavigation }}">
      {% if previousPost %}
      <a class="post-navigation-link post-navigation-previous" href="{{ previousPost.url }}" rel="prev">
        <span>{{ site.i18n[lang].previousStory }}</span>
        <strong>{{ previousPost.data.displayTitle }}</strong>
      </a>
      {% endif %}
      {% if nextPost %}
      <a class="post-navigation-link post-navigation-next" href="{{ nextPost.url }}" rel="next">
        <span>{{ site.i18n[lang].nextStory }}</span>
        <strong>{{ nextPost.data.displayTitle }}</strong>
      </a>
      {% endif %}
    </nav>
    <a class="all-stories-link" href="{% if lang == 'zh-TW' %}/zh/{% elif lang == 'ja' %}/ja/{% else %}/{% endif %}">{{ site.i18n[lang].allStories }}</a>
  </footer>
</article>
