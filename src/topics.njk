---
layout: layouts/base.njk
lang: en
section: topics
title: Topic map
description: Follow the published essays by topic.
permalink: /topics/
---
{% set posts = collections.postsEn %}
<section class="topic-map-page" aria-labelledby="topic-map-title">
  <h1 id="topic-map-title">{{ site.i18n[lang].topicMap }}</h1>
  <section class="topic-tag-index" aria-labelledby="topic-tags-title">
    <h2 id="topic-tags-title">{{ site.i18n[lang].tags }}</h2>
    <ul class="topic-tag-list">
    {% for topic in site.topicCatalog %}
      {% set relatedPosts = posts | topicPosts(topic.id) %}
      {% if relatedPosts.length %}<li class="topic-tag" data-topic-id="{{ topic.id }}">{{ topic.labels[lang] }}</li>{% endif %}
    {% endfor %}
    </ul>
  </section>
  <section class="topic-article-index" aria-labelledby="topic-articles-title">
    <h2 id="topic-articles-title">{{ site.i18n[lang].allStories }}</h2>
    <ul class="topic-article-list">
      {% for post in posts %}
      <li class="topic-article-row">
        <h3><a href="{{ post.url }}">{{ post.data.displayTitle }}</a></h3>
        <ul class="article-topic-tags" aria-label="{{ site.i18n[lang].tags }}">
          {% for topic in site.topicCatalog %}{% if topic.id in post.data.topicIds %}<li>{{ topic.labels[lang] }}</li>{% endif %}{% endfor %}
        </ul>
      </li>
      {% endfor %}
    </ul>
  </section>
</section>
